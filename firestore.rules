rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default rule: Deny everything unless explicitly allowed below
    match /{document=**} {
      allow read, write: if false;
    }
    
    // PUBLIC COLLECTIONS (Anyone can read, ONLY Admin can write)
    match /mass_schedules/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /announcements/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /legacy_timeline/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /sacraments/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /daily_liturgy/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /gallery/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /past_officials/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /catholic_prayers/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /sac_firebase_config/{docId} { allow read: if true; allow write: if request.auth != null; }

    // PRAYER REQUESTS (Anyone can READ and CREATE. ONLY Admin can Update/Delete)
    match /prayer_requests/{docId} {
      allow read: if true;
      allow create: if true; 
      allow update, delete: if request.auth != null;
    }

    // VISITORS (Anyone can read/write to update the counter)
    match /stats/{docId} {
      allow read, write: if true;
    }
    
    // VISITOR LOGS (Anyone can write, ONLY admin can read)
    match /visitor_logs/{docId} {
      allow read: if request.auth != null;
      allow write: if true;
    }
    
    // PUSH SUBSCRIBERS (Anyone can subscribe)
    match /push_subscribers/{docId} {
      allow read, write: if true;
    }
  }
}
